#!/usr/bin/env bash
set -euo pipefail

bucket="${GCS_DOWNLOADS_BUCKET_NAME:-downloads.openwisp.io}"
assets=(index.html style.css script.js circle.gif)

if [[ ${1:-} == "--dry-run" ]]; then
  dry_run=true
elif [[ $# -eq 0 ]]; then
  dry_run=false
else
  printf 'Usage: %s [--dry-run]\n' "$0" >&2
  exit 2
fi

if [[ $dry_run == false ]] && ! command -v gcloud >/dev/null; then
  printf 'gcloud is required to deploy.\n' >&2
  exit 1
fi

for asset in "${assets[@]}"; do
  source="site/$asset"
  destination="gs://$bucket/$asset"
  if [[ ! -f $source ]]; then
    printf 'Missing deployment asset: %s\n' "$source" >&2
    exit 1
  fi
  command=(gcloud storage cp --cache-control="no-cache, max-age=0, must-revalidate" "$source" "$destination")
  if [[ $dry_run == true ]]; then
    printf '%q ' "${command[@]}"
    printf '\n'
  else
    "${command[@]}"
  fi
done
